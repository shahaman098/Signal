# ---- Xero connection (via MCP) ----
# The Xero MCP server (@xeroapi/xero-mcp-server) is launched as a stdio subprocess
# by the API. It authenticates with a Xero custom-connection client.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Command the API spawns to reach Xero over MCP. Override to point at a different
# transport (e.g. a remote MCP server via a proxy).
XERO_MCP_COMMAND=npx
XERO_MCP_ARGS=-y,@xeroapi/xero-mcp-server@latest

# Scopes the MCP server requests for its client-credentials token. Must be a
# subset of the scopes enabled on your Xero custom-connection app — if unset,
# the server requests broad defaults (incl. payroll) which fail unless your app
# has them all. NOTE: new custom connections only offer granular scopes, and
# QUOTES ride on accounting.invoices (verified live) — no quotes scope exists.
XERO_SCOPES=accounting.contacts accounting.settings accounting.invoices accounting.payments accounting.reports.aged.read

# Tax type stamped on line items for created quotes/invoices. UK orgs usually
# want OUTPUT2 (20% VAT) on sales lines; NONE = no VAT.
XERO_DEFAULT_TAX_TYPE=NONE
XERO_DEFAULT_ACCOUNT_CODE=200

# Select which Xero adapter the API wires up: "mcp" (real) or "fake" (in-memory demo data).
XERO_ADAPTER=fake

# ---- Gemini (chase-email drafting + agent decisions) ----
# Key from https://aistudio.google.com/api-keys. Empty key → offline
# rules/template fallbacks. NOTE: there is no "gemini-3.2" — current lineup:
#   gemini-3.5-flash      (default — most capable stable)
#   gemini-3.1-flash-lite (cheapest)
#   gemini-3.1-pro-preview
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Companies House (registry data + real-time change stream) ----
# Keys from https://developer.company-information.service.gov.uk — note REST and
# Stream are SEPARATE key types; a REST key is rejected by the streaming host.
# COMPANIES_HOUSE_API_KEY empty → fake adapter with canned demo intelligence.
# COMPANIES_HOUSE_STREAM_KEY empty → no live stream; falls back to 12h polling.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_STREAM_KEY=

# ---- Financial news (NewsAPI.org-compatible) ----
# Empty → fake adapter with canned demo headlines.
NEWS_API_KEY=

# ---- Company context store ----
# One JSON file per company: Companies House data (filing PDFs linked),
# news (source links), role. The agent reads these alongside Xero data.
CONTEXT_DIR=data/company-context

# ---- API server ----
PORT=4000

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Owner voice (chase emails are drafted in this identity/tone) ----
OWNER_NAME=
BUSINESS_NAME=
CHASE_STYLE=warm but direct, first-name terms, no corporate filler
