# ---- API server ----
HOST=127.0.0.1
PORT=4000

# ---- Web ----
# Runtime origin used by the Next server and its /api proxy route.
API_BASE_URL=http://127.0.0.1:4000

# ---- Creative Radar upstream ----
# Optional live backend from the creative intelligence stack. If these are not
# set and DASHSCOPE_API_KEY is present, Signal uses Qwen web search for live
# public creative signals instead of seeded or fake data.
CREATIVE_INTEL_API_BASE_URL=
CREATIVE_INTEL_BRAND_ID=
CREATIVE_INTEL_BRAND_NAME=
CREATIVE_INTEL_CATEGORY=
CREATIVE_INTEL_TIMEOUT_MS=30000
CREATIVE_INTEL_DEMO_MODE=0
SIGNAL_TARGET_BRAND_NAME=Celsius
SIGNAL_TARGET_CATEGORY=energy drinks

# ---- Qwen / Alibaba Model Studio ----
# Required for production agent runs. With WORKSPACE_ID set, the API defaults to
# the Singapore workspace-specific endpoint:
# https://{WORKSPACE_ID}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
WORKSPACE_ID=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

# ---- Signal MCP service ----
# Local base URL used by the custom MCP server when exposing Signal tools.
SIGNAL_API_BASE_URL=http://127.0.0.1:4000

# ---- Alibaba Model Studio Managed Agents ----
# Managed Agents API currently uses the cn-beijing region and requires a
# workspace-specific endpoint.
AGENTSTUDIO_URL=
