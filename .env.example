# ---- Xero connection (via MCP) ----
# The Xero MCP server (@xeroapi/xero-mcp-server) is launched as a stdio subprocess
# by the API. It authenticates with a Xero custom-connection client.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Command the API spawns to reach Xero over MCP. Override to point at a different
# transport (e.g. a remote MCP server via a proxy).
XERO_MCP_COMMAND=npx
XERO_MCP_ARGS=-y,@xeroapi/xero-mcp-server@latest

# Select which Xero adapter the API wires up: "mcp" (real) or "fake" (in-memory demo data).
XERO_ADAPTER=fake

# ---- Claude (chase-email drafting + agent decisions) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ---- Companies House (registry data + real-time change stream) ----
# Create a key at https://developer.company-information.service.gov.uk
# Empty → fake adapter with canned demo intelligence.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_STREAM=true

# ---- Financial news (NewsAPI.org-compatible) ----
# Empty → fake adapter with canned demo headlines.
NEWS_API_KEY=

# ---- Company context store ----
# One JSON file per company: Companies House data (filing PDFs linked),
# news (source links), role. The agent reads these alongside Xero data.
CONTEXT_DIR=data/company-context

# ---- API server ----
PORT=4000

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
